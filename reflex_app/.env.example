# Environment variables for Yvynation Reflex App
# Copy to .env and fill with your values

# Google Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# Reflex Configuration
REFLEX_ENV=dev
REFLEX_LOG_LEVEL=info
DEBUG=false

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Earth Engine
EE_INITIALIZE_ON_STARTUP=true
EE_USE_SERVICE_ACCOUNT=true

# Database (Reflex default)
REFLEX_DB_URL=sqlite:///reflex.db

# Abuse control (utils/abuse_control.py, docs/ABUSE_CONTROL.md)
# Rate limiting and access logging in front of run_batch_processing. Uses
# the same Earth Engine service-account credentials as everything else
# (implicit ADC locally, the attached runtime service account on Cloud Run)
# — no separate key needed.
YVY_ABUSE_BUCKET=yvynation-abuse-control
YVY_ABUSE_SESSION_COOLDOWN_S=300
YVY_ABUSE_IP_MAX_PER_WINDOW=3
YVY_ABUSE_IP_WINDOW_S=3600
